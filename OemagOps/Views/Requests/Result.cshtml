@model OemagOps.Models.IncomingRequest
@using OemagOps.Models

@{
    ViewData["Title"] = "Analyse";

    var analysis =
        ViewBag.AiAnalysis as AiRequestAnalysis;

    var missingInformation =
        ViewBag.MissingInformation as List<string>;

    var replyDraft =
        ViewBag.ReplyDraft as string;

    var offerDraft =
        ViewBag.OfferDraft as OfferDraft;

    var errorMessage =
        ViewBag.ErrorMessage as string;
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="mb-1">Anfrageanalyse</h2>

            <small class="text-muted">
                Anfrage #@Model.Id
            </small>
        </div>

        <div>

            @if (Model.Status == "READY_FOR_OFFER")
            {
                <span class="badge bg-success fs-6">
                    Bereit für Angebot
                </span>
            }
            else if (Model.Status == "MISSING_INFORMATION")
            {
                <span class="badge bg-warning text-dark fs-6">
                    Informationen fehlen
                </span>
            }
            else if (Model.Status == "PRODUCT_NOT_FOUND")
            {
                <span class="badge bg-danger fs-6">
                    Kein Produkt gefunden
                </span>
            }
            else if (Model.Status == "AI_ERROR")
            {
                <span class="badge bg-danger fs-6">
                    Fehler
                </span>
            }
            else
            {
                <span class="badge bg-secondary fs-6">
                    @Model.Status
                </span>
            }

        </div>

    </div>


    @* Fehler *@

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger">
            <strong>Fehler:</strong>
            @errorMessage
        </div>
    }


    @* Originalanfrage *@

    <div class="card mb-4">

        <div class="card-header">
            <strong>Originalanfrage</strong>
        </div>

        <div class="card-body">

            <div class="mb-3">
                <strong>Absender</strong>

                <div>
                    @Model.Sender
                </div>
            </div>

            <div class="mb-3">
                <strong>Betreff</strong>

                <div>
                    @Model.Subject
                </div>
            </div>

            <div>
                <strong>Nachricht</strong>

                <div class="mt-2 p-3 bg-light rounded"
                     style="white-space: pre-wrap;">
                    @Model.Body
                </div>
            </div>

        </div>

    </div>


    @* KI Analyse *@

    @if (analysis != null)
    {
        <div class="card mb-4">

            <div class="card-header">
                <strong>KI-Analyse</strong>
            </div>

            <div class="card-body p-0">

                <table class="table table-bordered mb-0">

                    <tbody>

                        <tr>
                            <th style="width: 230px;">
                                Anfrageart
                            </th>

                            <td>
                                @(analysis.RequestType
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Firma</th>

                            <td>
                                @(analysis.Company
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Ansprechpartner</th>

                            <td>
                                @(analysis.ContactPerson
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Produkt</th>

                            <td>
                                @(analysis.Product
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Menge</th>

                            <td>
                                @(analysis.Quantity.HasValue
                                    ? analysis.Quantity.Value.ToString()
                                    : "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Leistung</th>

                            <td>
                                @(analysis.PowerWp.HasValue
                                    ? analysis.PowerWp.Value + " Wp"
                                    : "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Farbe</th>

                            <td>
                                @(analysis.Color
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Standort / Lieferort</th>

                            <td>
                                @(analysis.Location
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Liefertermin</th>

                            <td>
                                @(analysis.DeliveryTime
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                        <tr>
                            <th>Zusammenfassung</th>

                            <td>
                                @(analysis.Summary
                                    ?? "Nicht angegeben")
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>


        @* Firmenregeln *@

        <div class="card mb-4">

            <div class="card-header">
                <strong>Prüfung nach Firmenregeln</strong>
            </div>

            <div class="card-body">

                @if (missingInformation != null &&
                     missingInformation.Count > 0)
                {
                    <div class="alert alert-warning mb-0">

                        <h5 class="alert-heading">
                            Anfrage unvollständig
                        </h5>

                        <p>
                            Für die weitere Bearbeitung fehlen:
                        </p>

                        <ul class="mb-0">

                            @foreach (var item in missingInformation)
                            {
                                <li>
                                    <strong>@item</strong>
                                </li>
                            }

                        </ul>

                    </div>
                }
                else
                {
                    <div class="alert alert-success mb-0">

                        <h5 class="alert-heading">
                            Anfrage vollständig
                        </h5>

                        <p class="mb-0">
                            Alle benötigten Informationen sind vorhanden.
                        </p>

                    </div>
                }

            </div>

        </div>


        @* Antwortentwurf bei fehlenden Informationen *@

        @if (!string.IsNullOrWhiteSpace(replyDraft))
        {
            <div class="card mb-4">

                <div class="card-header">
                    <strong>Automatischer Antwortentwurf</strong>
                </div>

                <div class="card-body">

                    <p class="text-muted">
                        Der Entwurf basiert ausschließlich auf den
                        fehlenden Informationen aus den Firmenregeln.
                    </p>

                    <textarea class="form-control"
                              rows="9">@replyDraft</textarea>

                    <div class="mt-3">

                        <button type="button"
                                class="btn btn-primary"
                                disabled>

                            E-Mail senden
                        </button>

                        <small class="text-muted ms-2">
                            Versand wird später angebunden.
                        </small>

                    </div>

                </div>

            </div>
        }


        @* Angebotsentwurf *@

        @if (offerDraft != null)
        {
            <div class="card mb-4 border-success">

                <div class="card-header">
                    <strong>Angebotsentwurf</strong>
                </div>

                <div class="card-body">

                    <div class="mb-3">

                        <strong>Kunde:</strong>

                        @offerDraft.CustomerName

                    </div>


                    <table class="table table-bordered">

                        <thead>

                            <tr>
                                <th>Position</th>

                                <th style="width: 100px;">
                                    Menge
                                </th>

                                <th style="width: 150px;">
                                    Einzelpreis
                                </th>

                                <th style="width: 150px;">
                                    Gesamt
                                </th>
                            </tr>

                        </thead>

                        <tbody>

                            <tr>

                                <td>
                                    @offerDraft.ProductName
                                </td>

                                <td>
                                    @offerDraft.Quantity
                                </td>

                                <td>
                                    @offerDraft.UnitPrice.ToString("N2") €
                                </td>

                                <td>
                                    @offerDraft.ProductTotal.ToString("N2") €
                                </td>

                            </tr>


                            <tr>

                                <td>
                                    Lieferung Österreich
                                </td>

                                <td>
                                    1
                                </td>

                                <td>
                                    @offerDraft.DeliveryCost.ToString("N2") €
                                </td>

                                <td>
                                    @offerDraft.DeliveryCost.ToString("N2") €
                                </td>

                            </tr>

                        </tbody>


                        <tfoot>

                            <tr>

                                <th colspan="3"
                                    class="text-end">

                                    Gesamt

                                </th>

                                <th>
                                    @offerDraft.GrandTotal.ToString("N2") €
                                </th>

                            </tr>

                        </tfoot>

                    </table>


                    <div class="alert alert-info">

                        <strong>Hinweis:</strong>

                        Produkt und Preise wurden aus der
                        SQL-Datenbank übernommen.

                        Die KI hat keine Preise berechnet oder erfunden.

                    </div>


                    <button type="button"
                            class="btn btn-success"
                            disabled>

                        Angebot freigeben

                    </button>

                    <small class="text-muted ms-2">
                        ERP / PDF / Versand bauen wir später ein.
                    </small>

                </div>

            </div>
        }


        @* Produkt nicht gefunden *@

        @if (Model.Status == "PRODUCT_NOT_FOUND")
        {
            <div class="alert alert-danger">

                <h5>
                    Kein passendes Produkt gefunden
                </h5>

                <p class="mb-0">
                    Die Anfrage ist vollständig, aber in der
                    Produktdatenbank konnte kein passender Artikel
                    gefunden werden.
                </p>

            </div>
        }
    }


    <div class="mt-4 mb-5">

        <a asp-controller="Requests"
           asp-action="Create"
           class="btn btn-secondary">

            Neue Anfrage

        </a>

    </div>

</div>